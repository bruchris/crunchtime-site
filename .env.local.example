# Anthropic API key for the Brief Box LLM call.
# Get one at https://console.anthropic.com/settings/keys.
# Local dev: copy this file to .env.local and fill in.
# Vercel: add as a Production + Preview env var.
ANTHROPIC_API_KEY=

# Booking link reused by end-card CTA (already used elsewhere in the site).
NEXT_PUBLIC_CAL_BOOKING_LINK=

# Email sending (Resend). CONTACT_FROM and CONTACT_INBOX are used by /api/lead
# and the existing /contact form. RESEND_API_KEY is shared across both.
RESEND_API_KEY=
CONTACT_INBOX=christian@crunchtime.no
CONTACT_FROM=Crunchtime <noreply@crunchtime.no>

# Lead capture (Plan 4)
# NOTION_TOKEN: Internal Integration Token from https://www.notion.so/profile/integrations.
# NOTION_DATABASE_ID: 32-char hex from the Crunchtime Leads database URL.
# NOTION_INSIGHTS_DATABASE_ID: 32-char hex from the Crunchtime Insights database URL.
# See docs/runbooks/notion-crm-setup.md for full setup instructions.
# See docs/runbooks/notion-insights-setup.md for the insights CMS setup.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_INSIGHTS_DATABASE_ID=
# Paperclip integration: /api/lead creates a Paperclip issue assigned to a
# Paperclip agent (default: CMO) that runs the research and emails the plan.
# See docs/runbooks/paperclip-webhook-contract.md for the contract.
PAPERCLIP_API_BASE=https://paperclip.bruchris.me
PAPERCLIP_API_TOKEN=
PAPERCLIP_COMPANY_ID=94dbb427-819a-4ec4-a02e-22fb24589604
PAPERCLIP_PROJECT_ID=aa2b0907-d47d-43b0-8498-60598efc5c75
PAPERCLIP_GOAL_ID=87858bb1-c9dc-4c5a-8146-582f1151795d
PAPERCLIP_AGENT_ID=c6fcaf55-42b6-4a02-b0a1-4d8b8e98c935
