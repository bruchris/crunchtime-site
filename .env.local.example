# Anthropic API key for the Brief Box LLM call.
# Get one at https://console.anthropic.com/settings/keys.
# Local dev: copy this file to .env.local and fill in.
# Vercel: add as a Production + Preview env var.
ANTHROPIC_API_KEY=

# Booking link reused by end-card CTA (already used elsewhere in the site).
NEXT_PUBLIC_CAL_BOOKING_LINK=

# Email sending (Resend). CONTACT_FROM and CONTACT_INBOX are used by /api/lead
# and the existing /contact form. RESEND_API_KEY is shared across both.
RESEND_API_KEY=
CONTACT_INBOX=christian@crunchtime.no
CONTACT_FROM=Crunchtime <noreply@crunchtime.no>

# Lead capture (Plan 4)
# NOTION_TOKEN: Internal Integration Token from https://www.notion.so/profile/integrations.
# NOTION_DATABASE_ID: 32-char hex from the Crunchtime Leads database URL.
# See docs/runbooks/notion-crm-setup.md for full setup instructions.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# PAPERCLIP_WEBHOOK_URL: endpoint that receives the research-agent trigger.
# See docs/runbooks/paperclip-webhook-contract.md for the contract.
PAPERCLIP_WEBHOOK_URL=
